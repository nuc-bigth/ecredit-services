# Environment Configuration Template
# Copy this file to .env.dev, .env.qas, or .env.prd and fill in the actual values
# DO NOT COMMIT REAL .env FILES

# Application Environment
NODE_ENV=dev

# Server Port
PORT=3035

# SQL Server Database Connection
DB_SERVER=<SQL_SERVER_HOST>
DB_INSTANCE_NAME=<SQL_SERVER_INSTANCE>
DB_PORT=1433
DB_USER=<DATABASE_USER>
DB_PASSWORD=<DATABASE_PASSWORD>
DB_NAME=eCredit
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Configuration
JWT_SECRET=<GENERATE_STRONG_SECRET>
JWT_EXPIRES_IN=24h

# Application URLs
APP_BASE_URL=https://localhost:3035
FRONTEND_BASE_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3035

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_DIRECTORY=./logs

# Attachment Storage Configuration
ATTACHMENT_STORAGE_DIRECTORY=\\cloudapp01\E\Files\eCredit
ATTACHMENT_PUBLIC_BASE_URL=https://app01.bigth.com/Files/eCredit/
ATTACHMENT_MAX_FILE_SIZE=10485760
DEFAULT_ATTACHMENT_TYPE_ID=f8781f2f-b4ac-4d95-bcc6-8b38b213ab20

# HTTPS Certificate Paths (UNC or local file system paths)
KEY_PATH=\\Cloudapp02\d\Certificates\private.key
CERT_PATH=\\Cloudapp02\d\Certificates\bigth.crt
CA_PATH=\\Cloudapp02\d\Certificates\CA_root.crt

# Microsoft Entra ID / MSAL Configuration (Single-Tenant)
MSAL_CLIENT_ID=<APPLICATION_CLIENT_ID>
MSAL_TENANT_ID=<DIRECTORY_TENANT_ID>
MSAL_AUTHORITY=https://login.microsoftonline.com/<DIRECTORY_TENANT_ID>
MSAL_EXPECTED_AUDIENCE=<APPLICATION_CLIENT_ID>
MSAL_EXPECTED_ISSUER=https://login.microsoftonline.com/<DIRECTORY_TENANT_ID>/v2.0
MSAL_API_CLIENT_ID=<APPLICATION_CLIENT_ID>
MSAL_API_SCOPE=api://<APPLICATION_CLIENT_ID>/access_as_user
MSAL_GRAPH_ENDPOINT=https://graph.microsoft.com/v1.0/me

# Swagger/OpenAPI Configuration
SWAGGER_TITLE=e-Credit Express API
SWAGGER_DESCRIPTION=e-Credit backend API with Microsoft Entra ID authentication
SWAGGER_VERSION=1.0.0
